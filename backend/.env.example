# development | production  (production'da /docs o'chadi va xavfli sozlamalar startda tekshiriladi)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://rulda:rulda@localhost:5433/rulda
# Kamida 32 belgili tasodifiy qiymat:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Frontenddagi VITE_GOOGLE_CLIENT_ID bilan AYNAN bir xil bo'lishi kerak (production'da majburiy).
GOOGLE_CLIENT_ID=
# Production: https://rulda.page,https://www.rulda.page
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# true bo'lsa tasdiqlash havolasi API javobida qaytadi (faqat lokal ishlab chiqish uchun!)
SIMPLE_EMAIL_MODE=true
# Path to the folder containing questions.json / road-signs.json, used to seed the DB once.
SEED_DATA_DIR=../public/data
# Click Merchant Cabinet (my.click.uz) dan olinadigan qiymatlar. Bo'sh bo'lsa to'lov o'chiq bo'ladi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Vergul bilan ajratilgan email(lar) - shu emaillar bilan kirgan (va email egaligi tasdiqlangan)
# foydalanuvchi /auth/me chaqirilganda avtomatik admin qilinadi.
ADMIN_EMAILS=
