DATABASE_URL=postgresql+psycopg://rulda:rulda@localhost:5433/rulda
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SIMPLE_EMAIL_MODE=true
# Path to the folder containing questions.json / road-signs.json, used to seed the DB once.
# docker-compose overrides this to /seed_data automatically.
SEED_DATA_DIR=../public/data
# Click Merchant Cabinet (my.click.uz) dan olinadigan qiymatlar. Bo'sh bo'lsa to'lov o'chiq bo'ladi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Vergul bilan ajratilgan email(lar) - shu emaillar bilan kirgan foydalanuvchi /auth/me chaqirilganda
# avtomatik admin qilinadi (yangi/bo'sh bazada birinchi adminni tayinlash uchun kerak).
ADMIN_EMAILS=
